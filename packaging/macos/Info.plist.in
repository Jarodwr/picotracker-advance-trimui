<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>picotracker_desktop</string>
  <key>CFBundleIdentifier</key><string>org.picotracker.advance-desktop</string>
  <key>CFBundleName</key><string>picoTracker Advance Desktop</string>
  <key>CFBundleDisplayName</key><string>picoTracker Advance Desktop</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@PICOTRACKER_BUNDLE_VERSION@</string>
  <key>CFBundleVersion</key><string>@PICOTRACKER_BUNDLE_VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>@CMAKE_OSX_DEPLOYMENT_TARGET_OR_DEFAULT@</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSApplicationCategoryType</key><string>public.app-category.music</string>
</dict>
</plist>
